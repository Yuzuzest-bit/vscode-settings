{
	"key":"ctrl+l",
	"command" : "runCommands",
	"args": {
		"commands": [
			// 1. 【重要】コマンドIDをこちらに修正しました
			"markdown.extension.toggleChecklist",
			// 2. カーソルを行末へ移動する
			"cursorEnd",
			// 3. タイムスタンプをスニペットとして挿入する
			{
				"command": "editor.action.insertSnippet",
				"args": {
					"snippet": " ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}"
				}
			}
		]
	},
	// 4. when句も、競合を避けるために少し変更します
	"when":"editorTextFocus && editorLangId == 'markdown'"
}
